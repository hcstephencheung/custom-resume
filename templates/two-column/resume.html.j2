<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ name }} – Resume</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Questrial&display=swap" rel="stylesheet">
<style>
  :root {
    --paper: #e4e2de;   /* warm light grey */
    --ink: #2b2b2b;     /* soft charcoal */
    --muted: #5a5956;
    --rule: #b9b7b3;
    --sidebar-bg: var(--ink);
    --sidebar-ink: var(--paper);
    --sidebar-rule: #6b6a67;
    --sidebar-muted: #a9a7a3;
    --display: "Bebas Neue", "Oswald", "League Gothic", sans-serif;
    --body: "Glacial Indifference", "Questrial", "Helvetica Neue", Arial, sans-serif;
  }

  @page { size: letter; margin: 0; }

  * { box-sizing: border-box; }
  html { background: #c9c7c3; }
  body {
    margin: 0;
    font-family: var(--body);
    font-size: 9.5pt;
    line-height: 1.45;
    color: var(--ink);
    font-variant-ligatures: none; /* "ﬁ" glyphs break ATS keyword matching */
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  ul { margin: 0; padding: 0; }
  a { color: inherit; text-decoration: none; }
  h1, h2, h3, p { margin: 0; }

  /* Header comes first in the DOM so ATS reads the name first; the grid
     places it visually at the top of the right column. Letter-spacing stays
     <= 0.08em because wider tracking is extracted as "S P A C E D" text. */
  .page {
    width: 8.5in;
    min-height: 11in;
    margin: 0.25in auto;
    background: var(--paper);
    display: grid;
    grid-template-columns: 25% 1fr;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      "sidebar header"
      "sidebar main";
  }
  @media print { .page { margin: 0; } html { background: none; } }

  /* ---------- Header ---------- */
  .header {
    grid-area: header;
    padding: 0.6in 0.6in 0.15in 0.5in;
  }
  .header h1 {
    font-family: var(--display);
    font-weight: 400;
    font-size: 46pt;
    line-height: 0.9;
    letter-spacing: 0.04em;
  }
  .header .headline {
    margin-top: 6pt;
    font-size: 12pt;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .header .headline::after {
    content: "";
    display: block;
    width: 0.55in;
    height: 3px;
    margin-top: 9pt;
    background: var(--ink);
  }

  /* ---------- Sidebar ---------- */
  .sidebar {
    grid-area: sidebar;
    background: var(--sidebar-bg);
    color: var(--sidebar-ink);
    padding: 0.6in 0.25in 0.5in 0.3in;
    font-size: 8.75pt;
  }
  .sidebar section + section { margin-top: 20pt; }
  .sidebar h2 {
    font-family: var(--display);
    font-weight: 400;
    font-size: 15pt;
    letter-spacing: 0.06em;
    padding-bottom: 3pt;
    margin-bottom: 7pt;
    border-bottom: 1px solid var(--sidebar-rule);
  }
  .sidebar dl { margin: 0; }
  .sidebar dt {
    font-size: 7pt;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sidebar-muted);
  }
  .sidebar dd { margin: 0 0 6pt; overflow-wrap: anywhere; }
  .sidebar h3 {
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin: 7pt 0 2pt;
  }
  .sidebar h3:first-of-type { margin-top: 0; }
  .sidebar li { list-style: none; }
  .sidebar li + li { margin-top: 4pt; }
  .sidebar .keywords li + li { margin-top: 0; }
  .sidebar .keywords li { display: inline; }
  .sidebar .keywords li:not(:last-child)::after { content: ", "; }
  .sidebar .entry + .entry { margin-top: 8pt; }
  .sidebar .entry .dates { color: var(--sidebar-muted); font-size: 8pt; }

  /* ---------- Main ---------- */
  .main {
    grid-area: main;
    padding: 0.15in 0.6in 0.5in 0.5in;
  }
  .main section + section { margin-top: 16pt; }
  .main h2 {
    font-size: 11pt;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-bottom: 3pt;
    margin-bottom: 8pt;
    border-bottom: 1px solid var(--ink);
  }
  .main .text { text-align: justify; }

  /* Timeline is drawn with a border and inline markers rather than
     positioned elements: positioned/translucent boxes are painted out of
     DOM order in PDFs, which scrambles the text order ATS parsers see. */
  .timeline { margin-left: 3pt; padding-left: 11pt; border-left: 1px solid var(--rule); }
  .entry { break-inside: avoid; }
  .main .entry + .entry { margin-top: 11pt; }
  .timeline .entry h3::before {
    content: "";
    display: inline-block;
    width: 6pt; height: 6pt;
    margin: 0 8.5pt 1pt -14.5pt;
    border-radius: 50%;
    background: var(--ink);
  }
  .entry-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8pt;
  }
  .entry h3 { font-size: 10pt; font-weight: 700; }
  .entry .dates { font-size: 8.5pt; color: var(--muted); white-space: nowrap; }
  .entry .sub { color: var(--muted); }
  .entry ul { margin-top: 4pt; padding-left: 12pt; }
  .entry li + li { margin-top: 2pt; }
</style>
</head>
<body>
<div class="page">

  <header class="header">
    <h1>{{ name }}</h1>
    {% if headline %}<p class="headline">{{ headline }}</p>{% endif %}
  </header>

  <aside class="sidebar">
    <section>
      <h2>Contact</h2>
      <dl>
        {% for c in contact %}
        <dt>{{ c.label }}</dt>
        <dd>{% if c.href %}<a href="{{ c.href }}">{{ c.value }}</a>{% else %}{{ c.value }}{% endif %}</dd>
        {% endfor %}
      </dl>
    </section>

    {% for s in sidebar %}
    <section>
      <h2>{{ s.title }}</h2>
      {% if s.groups %}
        {% for g in s.groups %}
        <h3>{{ g.name }}</h3>
        <ul class="keywords">{% for item in g["items"] %}<li>{{ item }}</li>{% endfor %}</ul>
        {% endfor %}
      {% elif s.entries %}
        {% for e in s.entries %}
        <div class="entry">
          <h3>{{ e.heading }}</h3>
          {% if e.subheading %}<p>{{ e.subheading }}</p>{% endif %}
          {% if e.dates %}<p class="dates">{{ e.dates }}</p>{% endif %}
        </div>
        {% endfor %}
      {% elif s["items"] %}
        <ul>{% for item in s["items"] %}<li>{{ item }}</li>{% endfor %}</ul>
      {% endif %}
    </section>
    {% endfor %}
  </aside>

  <main class="main">
    {% for s in sections %}
    <section>
      <h2>{{ s.title }}</h2>
      {% if s.text %}
      <p class="text">{{ s.text }}</p>
      {% elif s.entries %}
      <div class="{{ 'timeline' if s.timeline else '' }}">
        {% for e in s.entries %}
        <article class="entry">
          <div class="entry-head">
            <h3>{{ e.heading }}</h3>
            {% if e.dates %}<span class="dates">{{ e.dates }}</span>{% endif %}
          </div>
          {% if e.subheading %}<p class="sub">{{ e.subheading }}{% if e.location %} · {{ e.location }}{% endif %}</p>{% endif %}
          {% if e.bullets %}
          <ul>{% for b in e.bullets %}<li>{{ b }}</li>{% endfor %}</ul>
          {% endif %}
        </article>
        {% endfor %}
      </div>
      {% endif %}
    </section>
    {% endfor %}
  </main>

</div>
</body>
</html>
